# Copy to backend/.env and edit. Nothing here is secret - the account passwords
# live in the store, not in the environment - so this file exists to keep the
# machine-specific settings out of the code.

# 4300 because 4000, 4100 and 4200 are the Instagram, Threads and Meetup bots on
# the machine these run beside. Two servers cannot share a port.
XBOT_HOST=127.0.0.1
XBOT_PORT=4300

# Leave headless off. A login that has to be handed a code from an email cannot
# be completed against a browser nobody can see.
XBOT_HEADLESS=0

# Playwright's own Chromium unless this names something else. `chrome` uses the
# installed Google Chrome, which is the less unusual client of the two.
# XBOT_BROWSER_CHANNEL=chrome

# Reload the server when the code changes. Development only: it restarts the
# process, and a restart takes the browser and any running campaign with it.
XBOT_RELOAD=0

# --------------------------- MINIO ---------------------------
# Where a finished roster is sent. Optional: with nothing here (or with no MinIO
# running) the console works exactly as before and says so on the pill.
#
# The same four names the Instagram and Threads bots read, so one block serves
# every bot on this machine. MINIO_BUCKET is the exception - x-bot forces
# whatever is set here into its own `x-` namespace, so a name left over from
# another bot cannot have X handles written into it.
#
# `x-` and not `x_`: a bucket name is a DNS label, so MinIO allows lowercase
# letters, digits, hyphens and dots and nothing else. `x_usernames` written here
# is read as `x-usernames` rather than failing at the moment the bucket has to
# be created.
MINIO_URL=localhost:9000
MINIO_USER=admin
MINIO_PASSWORD=
MINIO_BUCKET=x-usernames
# Plain HTTP unless the MinIO in front of this is behind a real certificate.
MINIO_SECURE=0

# ------------------------- FIRECRAWL -------------------------
# The profile RE-READ (Data step: "read members") can go out through Firecrawl
# instead of driving a signed-in window. With a key set, re-reading five hundred
# profiles leaves no automation footprint on any account - the requests land on
# Firecrawl's proxy, not on a browser this console is logged in on - and it needs
# no window open at all. The walk of the home feed is unchanged: that is behind
# the login wall and stays on the local browser.
#
# Leave the key blank and everything behaves exactly as before (the re-read reads
# off a window). Firecrawl CANNOT see whether an inbox is open - `dm_open` needs
# the logged-in session - so a Firecrawl re-read fills in name, bio, followers,
# protected and exists, and leaves the inbox to a browser re-read.
# FIRECRAWL_API_KEY=fc-...
# The cloud unless pointed at a self-hosted instance. A `/v1` or `/v2` suffix is
# trimmed automatically, so either spelling is fine.
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# `stealth` is the residential-proxy mode built to get past anti-bot; `basic` or
# `auto` are the cheaper datacenter options a self-hosted box may prefer.
# FIRECRAWL_PROXY=stealth
# One profile read's ceiling, in seconds.
# FIRECRAWL_TIMEOUT=60
# Force it on or off. Unset, it is on whenever a key or a self-hosted base URL is
# present. `0` keeps a key in the file but reads off the window; `1` turns it on
# for a self-hosted instance that needs no key.
# FIRECRAWL_ENABLED=1
