# messenger-bot — environment template.
#
#     cp backend/.env.example backend/.env       (Windows: Copy-Item)
#
# `backend/.env` is gitignored. Nothing here is a Facebook credential — the
# account passwords live in the store — but the MinIO password is a secret.
# A real environment variable always beats a value in this file.

# ─── Server ──────────────────────────────────────────────────────────────
# Local desktop: 127.0.0.1. In Docker / on the VM: 0.0.0.0 (compose sets it).
XBOT_HOST=127.0.0.1
# 4300: the Instagram, Threads and Meetup bots use 4000, 4100 and 4200.
XBOT_PORT=4300
# Reload on code change — development only (a restart kills Chrome + any run).
XBOT_RELOAD=0

# ─── Browser ─────────────────────────────────────────────────────────────
# 0 = headed: you SEE Chrome (local desktop, or the VM's web desktop).
# 1 = headless: no window. Logins that need a code from an email cannot be
#     finished headless, so leave this at 0 in production.
XBOT_HEADLESS=0
# chrome  = installed Google Chrome (the container image has it).
# chromium = Playwright's bundled build. Unset falls back automatically.
XBOT_BROWSER_CHANNEL=chrome
# Which X display shows the windows in the container (the web desktop's).
DISPLAY=:1
# How long one automation call may run, seconds.
XBOT_AUTOMATION_TIMEOUT=3600

# ─── MinIO / S3 object store (shared with the other bots) ───────────────
# The databases VM hosts one store for every bot. Leave MINIO_URL empty to
# run without it (rosters stay in the local store only).
MINIO_URL=192.168.122.80:9000
MINIO_USER=admin
MINIO_PASSWORD=CHANGE_ME
MINIO_SECURE=0
# This bot's own handles (Facebook handles are not Instagram usernames).
MINIO_BUCKET=messenger-bot-usernames
# Shared with the Instagram bot on purpose: the same drafts and pictures.
MINIO_BUCKET_MESSAGES=insta-bot-messages
MINIO_BUCKET_MEDIA=insta-bot-media
# Empty = the groups file lives in MINIO_BUCKET.
MINIO_BUCKET_GROUPS=

# ─── Firecrawl (optional profile re-read without a browser) ─────────────
# FIRECRAWL_API_KEY=fc-...
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
# FIRECRAWL_PROXY=stealth
# FIRECRAWL_TIMEOUT=60
# FIRECRAWL_ENABLED=1
